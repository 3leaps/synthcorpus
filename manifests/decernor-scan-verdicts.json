{
  "schema_version": "v0",
  "kind": "synthcorpus-decernor-scan-verdicts",
  "material_lane": "committed-synthetic",
  "fixtures_root": "fixtures-agent",
  "expectation_source": "GnuPG doc/keyformat.txt agent key forms; fixture class intent. Not derived from detector output.",
  "expectation_provenance": {
    "class": "format fact: each specimen's key form per doc/keyformat.txt, or a declared ambiguity that must fail closed",
    "code": "detector contract: the finding code decernor documents for that class",
    "severity": "policy judgement: per-profile severity from decernor's documented profile table, not from the format specification",
    "guardread": "policy judgement: key-shaped content of any class is refused"
  },
  "placements": {
    "agent-key-dir": "<home>/private-keys-v1.d/<name>",
    "keyring-home": "<home>/<name>",
    "root": "<root>/<name>"
  },
  "invariant_rules": {
    "has-finding": "at least one finding for the specimen, in every profile",
    "not-hardware-stub": "no finding classifies the specimen as hardware-stub",
    "unsafe-every-profile": "at least one unsafe finding, in every profile",
    "guardread-refuse": "guardread refuses with empty stdout",
    "guardread-pass": "guardread passes",
    "no-secret-exposure": "no finding reports exposure secret",
    "no-finding": "no finding for the specimen, in every profile"
  },
  "class_invariants": {
    "plaintext": [
      "has-finding",
      "not-hardware-stub",
      "unsafe-every-profile",
      "guardread-refuse"
    ],
    "protected": [
      "has-finding",
      "not-hardware-stub",
      "guardread-refuse"
    ],
    "malformed": [
      "has-finding",
      "not-hardware-stub",
      "unsafe-every-profile",
      "guardread-refuse"
    ],
    "hardware-stub": [
      "has-finding",
      "no-secret-exposure",
      "guardread-refuse"
    ],
    "benign": [
      "no-finding",
      "guardread-pass"
    ],
    "keyring-internal": [
      "has-finding"
    ]
  },
